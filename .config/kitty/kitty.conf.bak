map ctrl+d launch --location=hsplit
map ctrl+r launch --location=vsplit
map Ctrl+W close_window

# Fonts
font_family      JetBrains Mono
bold_font        auto
italic_font      auto
bold_italic_font auto

font_size 12

# Background
# background #282c34

# Animation
cursor_trail 1
cursor_trail_decay 0.1 0.4

# BEGIN_KITTY_THEME
# Atelier Cave Dark
include current-theme.conf
# END_KITTY_THEME