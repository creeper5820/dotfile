{
    "cxx-config": {
        "prefix": "cxx-config",
        "body": [
            "set(CMAKE_EXPORT_COMPILE_COMMANDS ON)",
            "set(CMAKE_CXX_STANDARD_REQUIRED ON)",
            "set(CMAKE_CXX_STANDARD ${1:VERSION})",
            "set(CMAKE_BUILD_TYPE \"${2:TYPE}\")"
        ]
    },
    "global-search": {
        "prefix": "global-search",
        "body": "file(GLOB_RECURSE ${1:NAME} CONFIGURE_DEPENDS ${2:PATH})"
    },
    "cmake-config": {
        "prefix": "cmake-config",
        "body": [
            "cmake_minimum_required(VERSION ${1:VERSION})",
            "project(${2:NAME})"
        ]
    }
}
